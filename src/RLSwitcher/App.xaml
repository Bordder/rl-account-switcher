<Application x:Class="RLSwitcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:RLSwitcher"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>

      <local:AvatarBrushConverter x:Key="AvatarBrush" />
      <local:InitialConverter x:Key="Initial" />
      <local:LastUsedConverter x:Key="LastUsed" />
      <local:ActiveBorderBrushConverter x:Key="ActiveBorderBrush" />
      <local:ActiveThicknessConverter x:Key="ActiveThickness" />
      <local:BoolToVisibilityConverter x:Key="BoolVis" />
      <local:BoolToAngleConverter x:Key="BoolAngle" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
