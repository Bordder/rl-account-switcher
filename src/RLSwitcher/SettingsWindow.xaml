<ui:FluentWindow x:Class="RLSwitcher.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings" Width="620" Height="560"
                 Icon="pack://application:,,,/Assets/app.ico"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" x:Name="Tb" Title="Settings" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,6,20,0">
      <StackPanel>

        <TextBlock Text="Rocket League" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="Rocket League launch program (usually Launcher.exe)" Margin="0,0,0,4" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox Grid.Column="0" x:Name="ExeBox" />
          <ui:Button Grid.Column="1" Content="Browse" Margin="6,0,0,0" Click="BrowseExe_Click" />
          <ui:Button Grid.Column="2" Content="Detect" Margin="6,0,0,0" Click="DetectExe_Click" />
        </Grid>

        <TextBlock Text="Extra launch arguments (optional)" Margin="0,14,0,4" />
        <ui:TextBox x:Name="ArgsBox" PlaceholderText="e.g. -NOVSYNC -nomovie" />

        <Separator Margin="0,18" />

        <TextBlock Text="Credential vault" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock x:Name="VaultStatusText" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,10" />
        <WrapPanel>
          <ui:Button x:Name="MasterPwButton" Content="Enable master password"
                     Click="ToggleMasterPassword_Click" Margin="0,0,8,8" />
          <ui:Button Content="Clear Epic login cookies"
                     Click="ClearEpic_Click" Margin="0,0,8,8" />
          <ui:Button Content="Open app data folder" Click="OpenData_Click" Margin="0,0,0,8" />
        </WrapPanel>
        <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                   Text="Clearing cookies signs out the in-app browser so the next account you add starts fresh. It never touches your normal browser." />
        <ui:InfoBar Margin="0,12,0,0" IsOpen="True" Severity="Informational"
                    Title="Backups &amp; portability"
                    Message="Your logins are Epic refresh tokens, stored encrypted in vault.bin. With a master password that file is portable: copy it to another PC (or after a reset) to restore every account. DPAPI (no password) is local only." />

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
      <ui:Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True" />
      <ui:Button Content="Save" Appearance="Primary" Click="Save_Click" IsDefault="True" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
