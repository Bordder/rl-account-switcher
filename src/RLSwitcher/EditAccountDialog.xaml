<ui:FluentWindow x:Class="RLSwitcher.EditAccountDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Edit account" Width="460" Height="500"
                 Icon="pack://application:,,,/Assets/app.ico"
                 ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" x:Name="TitleBarControl" Title="Edit account" />

    <StackPanel Grid.Row="1" Margin="20,10,20,0">
      <TextBlock x:Name="EpicNameText" Opacity="0.6" FontSize="12" Margin="0,0,0,12" />

      <TextBlock Text="Nickname (blank = Epic name)" Margin="0,0,0,4" />
      <ui:TextBox x:Name="NicknameBox" />

      <TextBlock Text="Launch arguments for this account (optional)" Margin="0,14,0,4" />
      <ui:TextBox x:Name="ArgsBox" PlaceholderText="e.g. -nomovie -windowed -ResX=1920 -ResY=1080" />
      <TextBlock Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="Added after the global arguments from Settings, so these win on conflicts. Space-separated, same as Rocket League's own switches." />

      <Separator Margin="0,18" />

      <TextBlock Text="Usage" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock x:Name="LaunchCountText" FontSize="20" FontWeight="Bold" Foreground="#4C8DFF" />
          <TextBlock Text="launches" FontSize="11" Opacity="0.6" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="PlaytimeText" FontSize="20" FontWeight="Bold" Foreground="#4C8DFF" />
          <TextBlock Text="in game" FontSize="11" Opacity="0.6" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock x:Name="LastUsedText" FontSize="20" FontWeight="Bold" Foreground="#4C8DFF" />
          <TextBlock Text="last played" FontSize="11" Opacity="0.6" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
      <ui:Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True" />
      <ui:Button Content="Save" Appearance="Primary" Click="Save_Click" IsDefault="True" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
